# Copy to .env and change every value marked CHANGE-ME before starting.
OMEKA_DB_NAME=omeka
OMEKA_DB_USER=omeka
OMEKA_DB_PASSWORD=CHANGE-ME-db-password
MARIADB_ROOT_PASSWORD=CHANGE-ME-root-password

# First administrator, created on the first start. Leave empty to use the
# web installer at /install instead.
OMEKA_ADMIN_EMAIL=admin@example.com
OMEKA_ADMIN_NAME=Admin
OMEKA_ADMIN_PASSWORD=CHANGE-ME-admin-password

OMEKA_TITLE=Omeka S Finland Kit
# 1 = create the bilingual demo archive (/s/fi and /s/en) on first start.
KIT_DEMO=1
KIT_HTTP_PORT=8080
