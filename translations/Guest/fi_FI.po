msgid "Set \"home\" for home page (admin or public), \"site\" for the current site home, \"top\" for main public page, \"me\" for guest account, or any path starting with \"/\", including \"/\" itself for main home page."
msgstr "Anna \"home\" etusivulle (ylläpito tai julkinen), \"site\" nykyisen sivuston etusivulle, \"top\" julkiselle pääsivulle, \"me\" vierastilille tai mikä tahansa \"/\"-merkillä alkava polku, myös pelkkä \"/\" pääetusivulle."

msgid "Set false"
msgstr "Aseta epätodeksi"

msgid "Set true"
msgstr "Aseta todeksi"

msgid "Short Registration Features"
msgstr "Rekisteröitymisen hyödyt lyhyesti"

msgid "Site: %s"
msgstr "Sivusto: %s"

msgid "Skip email validation on register"
msgstr "Ohita sähköpostin vahvistus rekisteröityessä"

msgid "Skip terms agreement"
msgstr "Ohita käyttöehtojen hyväksyntä"

msgid "Stale Token"
msgstr "Käyttämätön avain"

msgid "Subject of email sent to update email"
msgstr "Sähköpostiosoitteen vaihtoviestin otsikko"

msgid "Subject of the email sent to administrator to notify about a new user"
msgstr "Ylläpitäjälle lähetettävän uuden käyttäjän ilmoituksen otsikko"

msgid "Subject of the email sent to confirm email"
msgstr "Sähköpostin vahvistusviestin otsikko"

msgid "Subject of the email sent to confirm registration after moderation"
msgstr "Tarkistuksen jälkeisen vahvistusviestin otsikko"

msgid "Submit new password"
msgstr "Tallenna uusi salasana"

msgid "Successfully logged out."
msgstr "Olet kirjautunut ulos."

msgid "Text for terms and conditions"
msgstr "Käyttöehtojen teksti"

msgid "Text to display after the forgot-password form"
msgstr "Salasanan palautuslomakkeen jälkeen näytettävä teksti"

msgid "Text to display after the login form"
msgstr "Kirjautumislomakkeen jälkeen näytettävä teksti"

msgid "Text to display after the registration form"
msgstr "Rekisteröitymislomakkeen jälkeen näytettävä teksti"

msgid "Thank you for registering. Please check your email for a confirmation message. Once you have confirmed your request and we have confirmed it, you will be able to log in."
msgstr "Kiitos rekisteröitymisestä. Tarkista sähköpostistasi vahvistusviesti. Kun olet vahvistanut pyyntösi ja me olemme hyväksyneet sen, voit kirjautua sisään."

msgid "Thank you for registering. Please check your email for a confirmation message. Once you have confirmed your request, a moderator will confirm registration."
msgstr "Kiitos rekisteröitymisestä. Tarkista sähköpostistasi vahvistusviesti. Kun olet vahvistanut pyyntösi, ylläpitäjä hyväksyy rekisteröitymisen."

msgid "Thank you for registering. Please check your email for a confirmation message. Once you have confirmed your request, you will be able to log in."
msgstr "Kiitos rekisteröitymisestä. Tarkista sähköpostistasi vahvistusviesti. Kun olet vahvistanut pyyntösi, voit kirjautua sisään."

msgid "Thank you for registering. You can now log in and use the library."
msgstr "Kiitos rekisteröitymisestä. Voit nyt kirjautua sisään ja käyttää palvelua."

msgid "Thanks for accepting the terms and conditions."
msgstr "Kiitos, että hyväksyit käyttöehdot."

msgid "Thanks for joining %s!"
msgstr "Kiitos rekisteröitymisestä %s -sivustolle!"

msgid "Thanks for joining {site_title}! You can now log in using the password you chose."
msgstr "Tervetuloa palveluun {site_title}! Voit nyt kirjautua sisään valitsemallasi salasanalla."

msgid "Thanks for joining {site_title}! Your registration is under moderation. See you soon!"
msgstr "Kiitos rekisteröitymisestä palveluun {site_title}! Rekisteröitymisesi odottaa hyväksyntää. Nähdään pian!"

msgid "The access to this website requires you accept the current terms and conditions."
msgstr "Sivuston käyttö edellyttää voimassa olevien käyttöehtojen hyväksymistä."

msgid "The display name must be 50 characters or fewer."
msgstr "Näyttönimessä voi olla enintään 50 merkkiä."

msgid "The display name must contain only letters and numbers."
msgstr "Näyttönimessä voi olla vain kirjaimia ja numeroita."

msgid "The email \"{email}\" is not yours."
msgstr "Sähköpostiosoite \"{email}\" ei ole sinun."

msgid "The email \"{user_email}\" is not yours."
msgstr "Sähköpostiosoite \"{user_email}\" ei ole sinun."

msgid "The list of emails to notify when a user registers, one by row."
msgstr "Sähköpostiosoitteet, joihin ilmoitetaan uusista rekisteröitymisistä, yksi per rivi."

msgid "The message of confirmation of the registration has been sent."
msgstr "Rekisteröitymisen vahvistusviesti on lähetetty."

msgid "The message to  display after confirmation of a mail."
msgstr "Sähköpostin vahvistamisen jälkeen näytettävä viesti."

msgid "The module %1$s should be upgraded to version %2$s or later."
msgstr "Moduuli %1$s on päivitettävä versioon %2$s tai uudempaan."

msgid "The new email is the same than the current one."
msgstr "Uusi sähköpostiosoite on sama kuin nykyinen."

msgid "The new name is empty."
msgstr "Uusi nimi puuttuu."

msgid "The role {role} is an admin role and cannot be used for registering. Role \"guest\" is used instead."
msgstr "Rooli {role} on ylläpitorooli, eikä sitä voi käyttää rekisteröitymisessä. Sen sijaan käytetään roolia \"guest\"."

msgid "The role {role} is not valid. Role \"guest\" is used instead."
msgstr "Rooli {role} ei ole kelvollinen. Sen sijaan käytetään roolia \"guest\"."

msgid "The site doesn’t exist."
msgstr "Sivustoa ei ole olemassa."

msgid "The text of the email sent when the user wants to update it."
msgstr "Viesti, joka lähetetään, kun käyttäjä haluaa vaihtaa sähköpostiosoitteensa."

msgid "The text of the email to confirm the registration and to send the token."
msgstr "Viesti, jolla rekisteröityminen vahvistetaan ja tunniste lähetetään."

msgid "The text to display to accept conditions."
msgstr "Ehtojen hyväksymiseen näytettävä teksti."

msgid "The text to display to accept conditions. When a page is set, use {link}text{/link} to wrap the link text."
msgstr "Ehtojen hyväksymiseen näytettävä teksti. Jos sivu on asetettu, merkitse linkkiteksti muodossa {link}teksti{/link}."

msgid "The text to use for the \"Log in\" link in the user bar"
msgstr "Käyttäjäpalkin \"Kirjaudu sisään\" -linkin teksti"

msgid "The text to use for the \"Register\" link in the user bar"
msgstr "Käyttäjäpalkin \"Rekisteröidy\" -linkin teksti"

msgid "The text to use for the label on the user’s dashboard"
msgstr "Käyttäjän oman näkymän otsikkoteksti"

msgid "The two passwords do not match."
msgstr "Salasanat eivät täsmää."

msgid "This dialog is not managed."
msgstr "Tätä ikkunaa ei tueta."

msgid "This dialog requires module Two-Factor Authentication."
msgstr "Tämä ikkuna vaatii Two-Factor Authentication -moduulin."

msgid "This option allows to display only the links for the other modules, like Single Sign-On."
msgstr "Tällä asetuksella näytetään vain muiden moduulien, kuten Single Sign-Onin, linkit."

msgid "This option is useful for modules that create derivative roles for guests."
msgstr "Tämä asetus on hyödyllinen moduuleille, jotka luovat vieraskäyttäjille johdettuja rooleja."

msgid "This parameter is used to manage some site related features, in particular messages."
msgstr "Tällä asetuksella hallitaan joitakin sivustokohtaisia toimintoja, erityisesti viestejä."

msgid "This token is invalid. Check your email."
msgstr "Tunniste on virheellinen. Tarkista sähköpostisi."

msgid "To allow full access via api increases risks of intrusion."
msgstr "Täyden pääsyn salliminen API:n kautta lisää tietomurron riskiä."

msgid "Unable to send email."
msgstr "Sähköpostia ei voitu lähettää."

msgid "Unauthorized access."
msgstr "Luvaton pääsy."

msgid "Unexpected error during creation of guest user: {exception}"
msgstr "Odottamaton virhe vieraskäyttäjää luotaessa: {exception}"

msgid "Unknown error before creation of user."
msgstr "Tuntematon virhe ennen käyttäjän luomista."

msgid "Unknown error during creation of user."
msgstr "Tuntematon virhe käyttäjää luotaessa."

msgid "Update Account"
msgstr "Päivitä käyttäjätili"

msgid "Update account"
msgstr "Päivitä tili"

msgid "Update account info and password"
msgstr "Päivitä käyttäjätilin tiedot ja salasana"

msgid "Update email"
msgstr "Vaihda sähköpostiosoite"

msgid "Use name when connected"
msgstr "Näytä nimi kirjautuneena"

msgid "Use site setttings"
msgstr "Käytä sivuston asetuksia"

msgid "User #{user_id} wants to change email from \"{email}\" to \"{email_2}\", used by user #{user_id_2} (second check)."
msgstr "Käyttäjä #{user_id} haluaa vaihtaa sähköpostiosoitteen \"{email}\" osoitteeseen \"{email_2}\", jota käyttää käyttäjä #{user_id_2} (toinen tarkistus)."

msgid "User #{user_id} wants to change email from \"{email}\" to \"{email_2}\", used by user #{user_id_2}."
msgstr "Käyttäjä #{user_id} haluaa vaihtaa sähköpostiosoitteen \"{email}\" osoitteeseen \"{email_2}\", jota käyttää käyttäjä #{user_id_2}."

msgid "User cannot log in: already logged."
msgstr "Kirjautuminen ei onnistu: olet jo kirjautunut."

msgid "User cannot login: already logged."
msgstr "Kirjautuminen ei onnistu: olet jo kirjautunut."

msgid "User cannot register: already logged."
msgstr "Rekisteröityminen ei onnistu: olet jo kirjautunut."

msgid "User is not active and cannot update password."
msgstr "Käyttäjä ei ole aktiivinen eikä voi vaihtaa salasanaa."

msgid "User name, email, or password is invalid"
msgstr "Käyttäjänimi, sähköpostiosoite tai salasana on virheellinen"

msgid "User not logged."
msgstr "Käyttäjä ei ole kirjautunut."

msgid "User token for {site_title}"
msgstr "Käyttäjätunniste palveluun {site_title}"

msgid "Validation error during creation of guest user: {exception}"
msgstr "Tarkistusvirhe vieraskäyttäjää luotaessa: {exception}"

msgid "Validation error during creation of user. Please check your input."
msgstr "Tarkistusvirhe käyttäjää luotaessa. Tarkista antamasi tiedot."

msgid "Value is required and can't be empty"
msgstr "Arvo vaaditaan, eikä se voi olla tyhjä"

msgid "When terms and conditions are updated, you may want guests agree them one more time. Warning: to set false will impact all guests. So warn them some time before."
msgstr "Kun käyttöehdot päivittyvät, voit pyytää vieraskäyttäjiä hyväksymään ne uudelleen. Varoitus: asetus vaikuttaa kaikkiin vieraskäyttäjiin, joten ilmoita heille hyvissä ajoin."

msgid "When the moderation is set, the user may be informed automatically when the admin activates account (check box in second user tab)."
msgstr "Kun tarkistus on käytössä, käyttäjälle voidaan ilmoittaa automaattisesti, kun ylläpitäjä aktivoi tilin (valintaruutu käyttäjän toisella välilehdellä)."

msgid "Wrong email or password."
msgstr "Väärä sähköpostiosoite tai salasana."

msgid "Wrong password."
msgstr "Väärä salasana."

msgid "You already agreed the terms and conditions."
msgstr "Olet jo hyväksynyt käyttöehdot."

msgid "You can now log in using the password you chose."
msgstr "Voit nyt kirjautua käyttäen valitsemaasi salasanaa."

msgid "You cannot change your password here."
msgstr "Et voi vaihtaa salasanaasi täällä."

msgid "You cannot send a message to confirm registration: user is not active."
msgstr "Vahvistusviestiä ei voi lähettää: käyttäjä ei ole aktiivinen."

msgid "You cannot update email and another data in the same time."
msgstr "Et voi vaihtaa sähköpostiosoitetta ja muita tietoja samanaikaisesti."

msgid "You cannot update password and another data in the same time."
msgstr "Et voi vaihtaa salasanaa ja muita tietoja samanaikaisesti."

msgid "You have been logged out, but can continue browsing the site."
msgstr "Sinut on kirjattu ulos. Voit kuitenkin jatkaa sivuston selailua."

msgid "You have registered for an account on %s. Please confirm your registration by following %s.  If you did not request to join %s please disregard this email."
msgstr "Olet lähettänyt rekisteröitymispyynnön %s -sivustolle. Vahvista rekisteröitymisesi seuraamalla %s.  Jos et mielestäsi ole lähettänyt rekisteröitymispyyntöä %s -sivustolle, voit poistaa tämän viestin."

msgid "Your %s account"
msgstr "Käyttäjätilisi %s -sivustolla"

msgid "Your account has not been confirmed: check your email."
msgstr "Tiliäsi ei ole vahvistettu: tarkista sähköpostisi."

msgid "Your account is under moderation for opening."
msgstr "Tilisi odottaa avaamista ja tarkistusta."

msgid "Your email \"{user_email}\" is confirmed for {site_title}."
msgstr "Sähköpostiosoitteesi \"{user_email}\" on vahvistettu palveluun {site_title}."

msgid "Your modifications have been saved."
msgstr "Muutokset on tallennettu."

msgid "Your request contains metadata that cannot be updated."
msgstr "Pyyntösi sisältää metatietoja, joita ei voi päivittää."

msgid "Your request to join %s"
msgstr "Pyyntösi rekisteröityä %s sivustolle"

msgid "Your temporary access to the site has expired. Please check your email for the link to follow to confirm your registration."
msgstr "Väliaikainen käyttöoikeutesi on päättynyt. Ole hyvä ja vie rekisteröityminen päätökseen klikkaamalla linkkiä sähköpostiosoitteeseesi lähetetyssä rekisteröintiviestissä."

msgid "[GuestApi] An error occurred when the email was sent."
msgstr "[GuestApi] Sähköpostin lähettämisessä tapahtui virhe."

msgid "[Guest] An error occurred when the email was sent."
msgstr "[Guest] Sähköpostin lähettämisessä tapahtui virhe."

msgid "[Guest] An error occurred when the notification email was sent."
msgstr "[Guest] Ilmoitussähköpostin lähettämisessä tapahtui virhe."

msgid "[Guest] Site #{site_slug} is not available."
msgstr "[Guest] Sivusto #{site_slug} ei ole käytettävissä."

msgid "[No message]"
msgstr "[Ei viestiä]"

msgid "[No subject]"
msgstr "[Ei otsikkoa]"

msgid "[Omeka Guest] New registration"
msgstr "[Omeka Guest] Uusi rekisteröityminen"

msgid "[Unknown idp]"
msgstr "[Tuntematon tunnistuspalvelu]"

msgid "[{site_title}] A user is registering"
msgstr "[{site_title}] Uusi käyttäjä rekisteröityy"

msgid "[{site_title}] Account open"
msgstr "[{site_title}] Tili avattu"

msgid "[{site_title}] Confirm email"
msgstr "[{site_title}] Vahvista sähköpostiosoite"

