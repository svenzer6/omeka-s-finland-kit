msgstr "Hei {user_name},\nOlet rekisteröitynyt käyttäjäksi palveluun {main_title} / {site_title} ({site_url}).\nVahvista rekisteröitymisesi tästä linkistä: {token_url}.\nJos et ole rekisteröitynyt palveluun {main_title}, voit jättää tämän viestin huomiotta."

msgid "Hi {user_name},\nYou have requested to update email on {main_title} / {site_title} ({site_url}).\nPlease confirm your email by following this link: {token_url}.\nIf you did not request to update your email on {main_title}, please disregard this email."
msgstr "Hei {user_name},\nOlet pyytänyt sähköpostiosoitteesi vaihtamista palvelussa {main_title} / {site_title} ({site_url}).\nVahvista sähköpostiosoitteesi tästä linkistä: {token_url}.\nJos et ole pyytänyt sähköpostiosoitteen vaihtamista palvelussa {main_title}, voit jättää tämän viestin huomiotta."

msgid "Hi,\nA new user, {user_name}, is registering on <a href=\"{site_url}\">{site_title}</a> ({main_title}).\nYou may moderate this email: {user_email}.\nThis is an automatic message."
