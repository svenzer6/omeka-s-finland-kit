msgid "\"{email}\" is not an email."
msgstr "\"{email}\" ei ole sähköpostiosoite."

msgid "<p>Hi {user_name},</p>\n<p>We are happy to open your account on <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n<p>Please confirm your email by following this link: <a href=\"{token_url}\">{token_url}</a>.</p>\n<p>You can now log in and discover the site.</p>"
msgstr "<p>Hei {user_name},</p>\n<p>Tilisi sivustolla <a href=\"{site_url}\">{site_title}</a> ({main_title}) on avattu.</p>\n<p>Vahvista sähköpostiosoitteesi tästä linkistä: <a href=\"{token_url}\">{token_url}</a>.</p>\n<p>Voit nyt kirjautua sisään ja tutustua sivustoon.</p>"

msgid "<p>Hi {user_name},</p>\n<p>You have registered for an account on <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n<p>Please confirm your registration by following this link: <a href=\"{token_url}\"> {token_url}</a></p>\n<p>If you did not request to join {main_title} / {site_title}, please disregard this email.</p>"
msgstr "<p>Hei {user_name},</p>\n<p>Olet rekisteröitynyt käyttäjäksi sivustolle <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n<p>Vahvista rekisteröitymisesi tästä linkistä: <a href=\"{token_url}\"> {token_url}</a></p>\n<p>Jos et ole rekisteröitynyt palveluun {main_title} / {site_title}, voit jättää tämän viestin huomiotta.</p>"

msgid "<p>Hi {user_name},</p>\n<p>You have requested to update email on <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n<p>Please confirm your email by following this link: <a href=\"{token_url}\">{token_url}</a>.</p>\n<p>If you did not request to update your email on {main_title}, please disregard this email.</p>"
msgstr "<p>Hei {user_name},</p>\n<p>Olet pyytänyt sähköpostiosoitteesi vaihtamista sivustolla <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n<p>Vahvista sähköpostiosoitteesi tästä linkistä: <a href=\"{token_url}\">{token_url}</a>.</p>\n<p>Jos et ole pyytänyt sähköpostiosoitteen vaihtamista palvelussa {main_title}, voit jättää tämän viestin huomiotta.</p>"

msgid "<p>Hi,</p>\n<p>A new user, {user_name}, is registering on <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n<p>You may moderate this email: {user_email}.</p>\n<p>This is an automatic message.</p>"
msgstr "<p>Hei,</p>\n<p>Uusi käyttäjä {user_name} on rekisteröitymässä sivustolle <a href=\"{site_url}\">{site_title}</a> ({main_title}).</p>\n<p>Voit tarkistaa sähköpostiosoitteen: {user_email}.</p>\n<p>Tämä on automaattinen viesti.</p>"

msgid "A default site should be set or the user should have a site in order to confirm registration."
msgstr "Rekisteröitymisen vahvistaminen edellyttää, että oletussivusto on asetettu tai käyttäjällä on sivusto."

