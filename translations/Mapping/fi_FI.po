msgid "\n                <p>Enter the values, separated by new lines. The format of each value depends on the query type:</p>\n                <ul>\n                    <li>\"Is exactly\": enter a value that is an exact match to the property value.</li>\n                    <li>\"Contains\": enter a value that matches any part of the property value.</li>\n                    <li>\"Is resource with ID\": enter the resource ID (item, item set, media).</li>\n                </ul>"
msgstr "\n                <p>Anna arvot, kukin omalle rivilleen. Kunkin arvon muoto riippuu kyselytyypistä:</p>\n                <ul>\n                    <li>\"On täsmälleen\": anna arvo, joka vastaa ominaisuuden arvoa täsmälleen.</li>\n                    <li>\"Sisältää\": anna arvo, joka vastaa mitä tahansa ominaisuuden arvon osaa.</li>\n                    <li>\"On resurssi, jolla on ID\": anna resurssin ID (aineisto, aineistojoukko, media).</li>\n                </ul>"

