msgid "Remove Contact Us files"
msgstr "Poista Yhteydenotto-lisäosan tiedostot"

msgid "Removed the \"id\" system field from {count} contact form blocks."
msgstr "”id”-järjestelmäkenttä on poistettu {count} yhteydenottolomakkeen lohkosta."

msgid "Removed {count} orphan zip files (message deleted): {ids}."
msgstr "Poistettiin {count} irrallista ZIP-tiedostoa (viesti poistettu): {ids}."

msgid "Removed {count} stored zip files: zips are now streamed on demand, so no file is kept and existing links still work."
msgstr "Poistettu {count} tallennettua zip-tiedostoa: zip-tiedostot ladataan nyt pyynnöstä, joten tiedostoja ei säilytetä, ja olemassa olevat linkit toimivat edelleen."

msgid "Reply to the contact"
msgstr "Vastaa yhteydenottajalle"

msgid "Reply-to address when answering a contact"
msgstr "Vastausosoite yhteydenottoon vastattaessa"

msgid "Resource does not exist."
msgstr "Resurssia ei ole olemassa."

msgid "Resource has no file."
msgstr "Resurssilla ei ole tiedostoa."

msgid "Resource is invalid."
msgstr "Resurssi ei kelpaa."

msgid "See the block \"Contact us\" for a simple list. Separate questions and answer with a \"=\". Questions may be translated."
msgstr "Katso yksinkertainen luettelo “Yhteydenotto” -lohkosta. Erota kysymys ja vastaus \"=\"-merkillä. Kysymykset voidaan kääntää."

msgid "See the block \"Newsletter\" for a simple list. Separate questions and answer with a \"=\". Questions may be translated."
msgstr "Katso yksinkertainen luettelo \"Uutiskirje\"-lohkosta. Erota kysymys ja vastaus \"=\"-merkillä. Kysymykset voidaan kääntää."

