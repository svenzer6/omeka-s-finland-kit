msgid "Apply the theme to the default login page"
msgstr "Käytä sivuston teemaa oletuskirjautumissivulla"

msgid "Guest"
msgstr "Vierailija"

msgid "Guest private"
msgstr "Yksityinen vierailija"

msgid "Guest private site"
msgstr "Yksityisen sivuston vierailija"

msgid "Local api only"
msgstr "Vain paikallinen API"

msgid "No restriction"
msgstr "Ei rajoitusta"

msgid "Public api and local api"
msgstr "Julkinen ja paikallinen API"

msgid "Public api only"
msgstr "Vain julkinen API"

msgid "Redirect default top route to login when there is no public site"
msgstr "Ohjaa etusivu kirjautumiseen, kun julkista sivustoa ei ole"

msgid "Restrict api to authenticated users"
msgstr "Rajaa API vain kirjautuneille käyttäjille"

msgid "Search config"
msgstr "Hakuasetukset"

msgid "Search manager"
msgstr "Haun hallinta"

msgid "The setting \"default site\" refers to an inexisting site."
msgstr "Asetus \"oletussivusto\" viittaa sivustoon, jota ei ole olemassa."

msgid "This setting is useful when all sites are private, but resources are public. The api remains available with credentials and the local api remains available when logged."
msgstr "Tämä asetus on hyödyllinen, kun kaikki sivustot ovat yksityisiä mutta resurssit julkisia. API on käytettävissä tunnuksilla, ja paikallinen API on käytettävissä kirjautuneena."

msgid "Unauthorized (401)"
msgstr "Ei käyttöoikeutta (401)"

msgid "You do not have permission to access this resource."
msgstr "Sinulla ei ole oikeutta tähän resurssiin."
