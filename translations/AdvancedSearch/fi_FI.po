msgid "The search engine {search_slug} is not available in site {site_slug}. Check site settings or search config."
msgstr "Hakukone {search_slug} ei ole käytettävissä sivustolla {site_slug}. Tarkista sivuston asetukset tai hakuasetukset."

msgid "The search page \"{search_page}\" has no more suggester."
msgstr "Hakusivulla \"{search_page}\" ei ole enää ehdotinta."

